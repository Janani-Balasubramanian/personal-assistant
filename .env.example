# ==========================================
# JARVIS AI CONFIGURATION
# ==========================================
# Supported providers: gemini, groq, openai, ollama

# Option 1: Google Gemini (Recommended & Configured)
JARVIS_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
JARVIS_MODEL=gemini-3.5-flash-lite

# Option 2: Groq
# JARVIS_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# JARVIS_MODEL=llama-3.1-8b-instant

# Option 3: OpenAI
# JARVIS_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# JARVIS_MODEL=gpt-4o-mini

# Option 4: Local Ollama
# JARVIS_PROVIDER=ollama
# JARVIS_MODEL=llama3.2

# Voice settings (optional)
# JARVIS_MIC_THRESHOLD=0.018
# JARVIS_VOICE_RATE=175
# JARVIS_WHISPER_MODEL=small
